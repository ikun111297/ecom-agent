# 复制这份文件为 .env，然后填入真实的值。.env 不会被提交到 git。

# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=

# 可选：换模型 / 改接口地址 / 调回答温度（不填就用下面的默认值）
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_TEMPERATURE=0.3

# 飞书机器人（不使用飞书渠道可以不填）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 演示用：把飞书用户映射成哪个业务用户（订单归属校验用）
# FEISHU_DEMO_USER_ID=U1001
